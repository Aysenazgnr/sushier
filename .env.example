# Bu dosya örnek şablondur -- gerçek değerleri içermez ve güvenle commit
# edilebilir (bkz. .gitignore'daki !.env.example istisnası). Gerçek
# değerler Vercel panelinde (Production/Preview ortam değişkenleri) ve
# `vercel env pull` ile çekilen .env.local / .env.development.local
# dosyalarında durur, ikisi de .gitignore'da. Kurulum adımları için
# docs/mail-otomasyonu.md'ye bakın.

# --- Supabase (api/_lib/supabase.js, api/reservation-status.js) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Rezervasyon rate-limit hash'i (api/_lib/ip.js) ---
IP_HASH_SALT=

# --- Telegram bildirimleri (api/_lib/telegram.js) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude API: sohbet asistanı + günlük mail özeti (api/_lib/anthropic.js) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Resend: rezervasyon bildirim maili + müşteri hatırlatması (api/_lib/mail.js) ---
RESEND_API_KEY=
MAIL_FROM="Sushier <rezervasyon@sushier.com>"
MAIL_ALERT_TO=

# --- Cron endpoint'leri (api/cron-reminders.js, api/cron-digest.js) ---
# GitHub Actions'ın bu iki endpoint'i çağırırken kullandığı paylaşılan
# gizli anahtar. Hem Vercel'de hem GitHub repo secret'ında AYNI değer
# olmalı.
CRON_SECRET=

# --- Gelen kutusu özeti: Gmail IMAP (api/_lib/inbox.js) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
